//                                                      ARRAYS
(array hamesha 0th position se chalu hota h) (mtlb agar hame koi kahe ki hame 3rd position pe 12 likha h to iska matlb ham 4 no. pe 12 rakhenge )

->creat array(2 ways to create array)
let arr = [],  let arr = Array();

//modification of array 
let arr = [1, 2, 3, 4]
arr[2] = 12;      (iska mtlb arr ke 2th index ki jagha 12 rakh do)

// push
let arr = [1 ,2, 3, 4, 5]
arr.push(7000);   (ans me ye value arr me add ho jaygi mtlb ab arry kuch aisa dikhega [1 ,2, 3, 4, 5, 7000])

//pop
let arr = [1 ,2, 3, 4, 5]
arr.pop();     (pop se last ki ek value gayab ho jaygi)

//shift
let arr =[1 ,2, 3, 4, 5]
arr.shift();    ( shift starting se value hata deta H)

// unshift 
let arr =[1 ,2, 3, 4, 5]
arr.unshift(0); 
 (unshift stating me jo value aap doge wo aad kardeta h,
 ab array kuch aaisa dikhega [0, 1 ,2, 3, 4, 5] )

 //splice
 let arr =[1 ,2, 3, 4, 5]
 arr.splice(2, 1);     (splice beech me se value hata deta ,yaha pe 2 indicate kar raha h kis index position se value hatani h
 aur 1 indicate kar RAHA H kitni value hatani h)

 // slice
 let arr =[1 ,2, 3, 4, 5]
 let newarr = arr.slice(0, 4)  (slice ka kaam hota h ki wo main array ko change nhi karta h balki wo new aary return karta h (0, 4)ka matlb h ki oth position se lekar 4th index positin tak ki value ka new arry retun karega)

 //reverse
 (ye array ko reverse kar deta h)

 
 // sort
 let arr =[11 ,32, 3, 22, 45]
 let amit = arr.sort(function (a, b) {
    return a-b;
 })                                          (sort ek fuction accept karta h ,mtlb ye iska syntax h )
(sort array ko ascending order me change kar deta h jab return a-b hoga aur descending order me change kar dega jab b-a return hoga)


//forEach , map , reduce , sort ye sab function accept karte H



//forEach

let arr =[11 ,22, 33,34, 5]

arr.forEach(function (val) {
   console.log( val +5) 
})                      ( yaha pe ye code array ki har ek value ke liye ek baar chalta H)



//map

(map tab use krna h jab aapko ek naya array banan ho pichle array ke data ke basis pr
aur new array me purane array ki jitne same element hote H)

(map dikhte hi man me ek blannk array bana lena h)
let arr =[11 ,22, 33,34, 5]
arr.map(function(val){
    return 12;
}) 
(jab aapko koi aisa case dikh jaye jaha pr ek array se naya array banega and wo array kuch values ko rakhega tab map lagega)




//filter
filter same kaam karta h map ki tarha but ye new array me sirf kuch ki value ko bejhta h 

let arr =[11 ,22, 33,34, 5]
let newarr = arr.filter(function (val){
    if (val>5) return true;
})            (yaha pe return me true karoge to value new array me jaygi aur false karoge to value new array me nhi jaygi)


//reduce
reduce araay ko reduce karke single value me convert kar deta h.

let arr =[11 ,22, 33,34, 5]
let ans = arr.reduce(function (accumultor, val){
    return accumultor + val;
}, 0);            (yaha pe accumulator ek variable h jiski value last me 0 difine ki gai h)


//find

let arr = [
    { id: 1, key: 1}
    { id: 2, key: 2}
    { id: 3, key: 1}

];

let va = arr.find(function(val){
    return val.key === 1;
})          (find basically ye karta h ki array me se tumhare return kiye gaye value ke hisaab se element finde kark deta h)


//some
let arr = [10,23,40,89,90]
let any = arr.some(function (val){
    return val > 85;
});
  ( basically some jo h wo console me batata h ki jo tumne return ki condition rakhi h wo (true h ya false))koi baccha padhne wala h ya nhi

  
  
  
  //every
  let arr = [10,23,40,89,90]
  let amit = arr.every(function(val){
    return val > 10;
  });
(ye some ka opposite hota h aur hame ye batat h ki hamari return ki hui condition ko follow karta h ya nhi)




//desturcturing
let arr = [1, 2, 3, 4, 5]
let [a, b, , c] = arr;    (generally destructuing me ye hota h ki jo value hame array me nhi chaiye hoti use ham nikal dete h kuch is tareeke se)


