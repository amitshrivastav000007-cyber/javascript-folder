// returns and early returns

//return:- return ka mtlb hota h jaha se aaye ho wahi daal denge.
// early return function:- 


// -->first class function:- functions ko value ki tarha use kar skte H.
function abcd(val){
 val();
}
abcd(function(){
        console.log("chale ja bsdk")
});


//--> high order function:- hof wo hote h jo ya to function return kare ya fir accept kare apne para meter me
function abcd(){
return function(){
 console.log();
}
}
abcd()();                           (  yaha pe double ()() -> 1st () function ko chalane ke liye aur dusra return me jo value aai h usko chalane ke liye q ki return value bhi ek function h)




// pure vs impure fncs
pure function:- aise function jo bahar ki value ko na badle wo pure function h.
ex:-   
//let a = 12
//function abcd(){
//   consoel.log("balle balle ");
//}
//abcd(;)

//impure function:- aise function jo bahar ki value ko badal de wo asabhi impure function h.
let a = 12;
function hui(){
a++;
}





closures --> ek function jo return kare aur aur function aur return kiya hua function hamesha parent fnc ka ek variable use karega  
ex:- function abcd(){
    let a = 10
    return function(){
        consol.log(a);
    }
}

// lexical scoping:- lexical scoping ka matlab hota h ki pure function uske value ko access karna.
jaisa ki niche example me diya hua h a ki value pure function abcd  me access ki ja skti h aur wahi b ki only defg fnc me and c ki kewal ghij fnc me 
function abcd(){
    let a = 10;
    function defg(){
        let b = 20;
        function ghij(){
            c = 30
        }
    }
}



